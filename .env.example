# ==========================================
# JAY RAMJI BILL MANAGEMENT ENVIRONMENT SETUP
# ==========================================

# Backend Configuration (.env placed in backend/.env)
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/jayramji_bill
JWT_SECRET=your_jwt_secret_key_change_in_production_1234567890
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
FRONTEND_URL=http://localhost:3000

# Email Configuration
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# NVIDIA NIM AI OCR & Document Extraction (Purchase Bills & Invoices)
# Get your API key from: https://build.nvidia.com
NVIDIA_NIM_API_KEY=nvapi-your_nvidia_nim_api_key_here
NVIDIA_NIM_MODEL=meta/llama-3.2-11b-vision-instruct

# Frontend Configuration (.env.local placed in frontend/.env.local)
BACKEND_URL=http://localhost:5000/api

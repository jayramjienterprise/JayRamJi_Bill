# Port configuration
PORT=5000

# Environment: development, production, test
NODE_ENV=development

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/jayramji_bill

# JWT Authentication Secret Key (Provide a secure random 32+ char secret in production)
JWT_SECRET=your_jwt_secret_key_change_in_production_1234567890

# Cloudinary Storage Configuration (Required in production)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend App URL for CORS validation
FRONTEND_URL=http://localhost:3000

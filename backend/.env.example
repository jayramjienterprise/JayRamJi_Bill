# Port configuration
PORT=5000

# Environment: development, production, test
NODE_ENV=development

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/jayramji_bill

# JWT Authentication Secret Key (Provide a secure random 32+ char secret in production)
JWT_SECRET=your_jwt_secret_key_change_in_production_1234567890

# Cloudinary Storage Configuration (Required for file & PDF bill uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend App URL for CORS validation
FRONTEND_URL=http://localhost:3000

# Email Configuration (Nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false

# NVIDIA NIM AI OCR & Document Extraction (Purchase Bills & Invoices)
# Get your API key from: https://build.nvidia.com
NVIDIA_NIM_API_KEY=nvapi-your_nvidia_nim_api_key_here
NVIDIA_NIM_MODEL=meta/llama-3.2-11b-vision-instruct
